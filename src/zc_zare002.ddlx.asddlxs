@Metadata.layer: #CORE

@UI: {
  headerInfo: { typeName: 'Payment Item',
                typeNamePlural: 'Items' },
  presentationVariant: [ { sortOrder: [ { by: 'PostingDate',       direction: #DESC },
                                        { by: 'PaymentDocumentNo', direction: #ASC  } ],
                           visualizations: [ { type: #AS_LINEITEM } ] } ]
}
annotate entity ZC_ZARE002 with
{
  @UI.hidden: true
  ItemUuid;

  @UI.lineItem: [ { position: 10, importance: #HIGH },
                  { type: #FOR_ACTION, dataAction: 'submitItem', label: 'Submit',
                    position: 1, invocationGrouping: #CHANGE_SET },
                  { type: #FOR_ACTION, dataAction: 'rejectItem', label: 'Reject',
                    position: 2, invocationGrouping: #CHANGE_SET } ]
  @UI.selectionField: [ { position: 50 } ]
  PaymentDocumentNo;

  @UI.lineItem: [ { position: 20, importance: #MEDIUM } ]
  NumberOfItemsInPayment;

  @UI.lineItem:      [ { position: 30, importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]
  CompanyCode;

  @UI.lineItem:      [ { position: 40, importance: #HIGH } ]
  @UI.selectionField: [ { position: 20 } ]
  PostingDate;

  @UI.lineItem:      [ { position: 50, importance: #HIGH } ]
  @UI.selectionField: [ { position: 40 } ]
  CustomerCode;

  @UI.lineItem: [ { position: 60, importance: #HIGH } ]
  CustomerName;

  @UI.lineItem: [ { position: 70, importance: #MEDIUM } ]
  BillingNoteNo;

  @UI.lineItem: [ { position: 80, importance: #MEDIUM } ]
  AccountingDocument;

  @UI.lineItem: [ { position: 90, importance: #MEDIUM } ]
  BillingDocument;

  @UI.lineItem: [ { position: 100, importance: #HIGH } ]
  InvoiceAmount;

  @UI.lineItem:       [ { position: 110, importance: #HIGH } ]
  @UI.selectionField: [ { position: 30 } ]
  @UI.textArrangement: #TEXT_ONLY
  Status;

  @UI.hidden: true
  StatusText;
  
  @UI.lineItem:       [ { position: 120, importance: #HIGH } ]
  @UI.selectionField: [ { position: 70 } ]
  PaymentAccountingDocument;

  @UI.lineItem: [ { position: 130, importance: #LOW } ]
  SubmitMessage;

  @UI.lineItem:       [ { position: 140, importance: #HIGH } ]
  @UI.selectionField: [ { position: 90 } ]
  ClearingAccountingDocument;

  @UI.lineItem: [ { position: 150, importance: #LOW } ]
  ClearingMessage;

  @UI.selectionField: [ { position: 60 } ]
  @UI.textArrangement: #TEXT_ONLY
  IsSubmitted;

  @UI.hidden: true
  SubmitStatusText;

  @UI.selectionField: [ { position: 80 } ]
  @UI.textArrangement: #TEXT_ONLY
  IsCleared;

  @UI.hidden: true
  ClearingStatusText;

  // ไม่อยู่ใน filter bar เป็นค่าเริ่มต้น เพิ่มได้ผ่าน Adapt Filters
  @UI.textArrangement: #TEXT_ONLY
  SalesforceStatus;

  @UI.hidden: true
  SalesforceStatusText;

  @UI.lineItem: [ { position: 160, importance: #HIGH } ]
  RejectReason;

  @UI.lineItem:       [ { position: 170, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 100 } ]
  RejectBatchId;
}