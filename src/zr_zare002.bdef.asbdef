managed with unmanaged save implementation in class zbp_r_zare002 unique;
strict ( 2 );
with draft;

define behavior for ZR_ZARE002 alias Item
//persistent table ztar_i002_item
draft table ztar_e002_item_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  // report นี้ไม่เคยสร้างหรือลบ item — row เกิดจาก ZARI002 เท่านั้น
  create;
  update;
  delete;

  // RejectReason เป็น field เดียวที่แก้ได้ทั้ง BO
  field ( numbering : managed ) ItemUuid;

  field ( readonly ) PaymentUuid,
                     ItemUuid,
                     SalesforceItemId,
                     CustomerCode,
                     BillingNoteNo,
                     AccountingDocument,
                     BillingDocument,
                     InvoicePostingDate,
                     Currency,
                     InvoiceAmount,
                     AmountPaid,
                     PartialAmount,
                     SaleSubmitDate;

  // admin field — managed runtime เติมให้เอง ห้ามให้ผู้ใช้แก้
  field ( readonly ) CreatedBy,
                     CreatedAt,
                     LastChangedBy,
                     LastChangedAt,
                     LocalLastChangedAt;

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;

  // ปุ่มบน toolbar — เฟสนี้ยังไม่มี logic (docs/05_ui_spec.md §6)
  // เฟสถัดไป: ขยาย keys ที่ติ๊กมาให้ครอบทุก item ของ payment เดียวกันก่อนทำงาน
  action submitItem;
  action rejectItem;

  mapping for ztar_i002_item
    {
      ItemUuid           = item_uuid;
      PaymentUuid        = payment_uuid;
      SalesforceItemId   = salesforce_item_id;
      CustomerCode       = customer_code;
      BillingNoteNo      = billing_note_no;
      AccountingDocument = accounting_document;
      BillingDocument    = billing_document;
      InvoicePostingDate = invoice_posting_date;
      Currency           = currency;
      InvoiceAmount      = invoice_amount;
      AmountPaid         = amount_paid;
      PartialAmount      = partial_amount;
      SaleSubmitDate     = sale_submit_date;
      RejectReason       = reject_reason;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}