managed implementation in class zbp_r_zare002 unique;
strict ( 2 );
with draft;

define behavior for ZR_ZARE002 alias Item
persistent table ztar_i002_item
draft table ztar_e002_item_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
// saver lsc_Item เขียน status + salesforce_status ลง ztar_i002_pymt (header ไม่อยู่ใน BO นี้)
with additional save
{
  // report นี้ไม่เคยสร้างหรือลบ item — row เกิดจาก ZARI002 เท่านั้น
  update;

  // draft ต้องการ create/delete ไว้สร้าง-ทิ้ง draft instance เอง
  // internal = framework ใช้ได้ แต่ไม่โผล่ใน OData
  // FE จึงสร้างหรือลบ item ไม่ได้อยู่ดี
  internal create;
  internal delete;

  // RejectReason เป็น field เดียวที่แก้ได้ทั้ง BO
  // และแก้ได้เฉพาะ payment ที่ยังไม่ถูก reject และยังไม่ post
  // เงื่อนไขอยู่ที่ get_instance_features
  field ( features : instance ) RejectReason;

  field ( readonly : update ) ItemUuid;

  field ( readonly ) PaymentUuid,
                     SalesforceItemId,
                     CustomerCode,
                     BillingNoteNo,
                     AccountingDocument,
                     BillingDocument,
                     InvoicePostingDate,
                     Currency,
                     InvoiceAmount,
                     AmountPaid,
                     PartialAmount,
                     SaleSubmitDate;

  // admin field — managed runtime เติมให้เอง ห้ามให้ผู้ใช้แก้
  field ( readonly ) CreatedBy,
                     CreatedAt,
                     LastChangedBy,
                     LastChangedAt,
                     LocalLastChangedAt;

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare;

  // ปุ่มบน toolbar เปิดปิดตามสถานะของ payment ดูที่ get_instance_features
  // เลือก item ใดก็ตาม = ทำกับทุก item ของ payment นั้น
  // submitItem ไม่มี logic โดยตั้งใจ การ post JE อยู่ที่ HTTP service ZARE002_SUBMIT (ZCL_ZARE002_SUBMIT_HTTP)
  // rejectItem ยิง SFDC ก่อน แล้ว saver ค่อย stamp status
  action ( features : instance ) submitItem;
  action ( features : instance ) rejectItem result [1] $self;

  mapping for ztar_i002_item
    {
      ItemUuid           = item_uuid;
      PaymentUuid        = payment_uuid;
      SalesforceItemId   = salesforce_item_id;
      CustomerCode       = customer_code;
      BillingNoteNo      = billing_note_no;
      AccountingDocument = accounting_document;
      BillingDocument    = billing_document;
      InvoicePostingDate = invoice_posting_date;
      Currency           = currency;
      InvoiceAmount      = invoice_amount;
      AmountPaid         = amount_paid;
      PartialAmount      = partial_amount;
      SaleSubmitDate     = sale_submit_date;
      RejectReason       = reject_reason;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}